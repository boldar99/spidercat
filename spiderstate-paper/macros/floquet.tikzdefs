% Keep the size of this file to a minimum to reduce preview compilation time in TikZiT %
\usepackage{amsfonts}
\usepackage{mathtools}

\usepackage{extarrows}
\usepackage{physics}
\usepackage{amssymb}

% Shorter minus and plus signs
\newcommand{\minu}{\texttt{-}}
\newcommand{\plus}{\texttt{+}}
\newcommand{\FaultEq}{\widehat{=}}
\newcommand{\NotFaultEq}{\widehat{\not=}}

% used in ZX-diagrams
\definecolor{zxRed}{RGB}{232, 165, 165}
\definecolor{zxGreen}{RGB}{216, 248, 216}
\definecolor{zxHad}{RGB}{255, 255, 130}
\definecolor{zxGrey}{RGB}{211,211,211}
\definecolor{zxDarkRed}{RGB}{150, 100, 100}
\definecolor{zxDarkGreen}{RGB}{158, 200, 158}
\definecolor{verylightgray}{RGB}{235,235,235}


\usepackage{pgfplots}
\pgfplotsset{compat=newest, compat/show suggested version=false}
\usetikzlibrary{decorations, arrows.meta, calc}

\tikzset{addcross/.style={draw,path picture={%
  \draw[black]
       (path picture bounding box.north) -- (path picture bounding box.south)
       (path picture bounding box.west) -- (path picture bounding box.east);
}}}
\tikzset{addmeter/.append style={%
  draw, scale=0.3, inner sep=10, rectangle, font=\vphantom{A}, minimum width=30, path picture={%
    \draw[black, line width=.1] ([shift={(.1,.2)}] path picture bounding box.south west) to [bend left=50] ([shift={(-.1,.2)}] path picture bounding box.south east);
    \draw[black,-latex, line width=.01] ([shift={(0,.1)}] path picture bounding box.south) -- ([shift={(.3,-.1)}] path picture bounding box.north);
  }
}}

