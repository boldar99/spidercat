@online{gidneyMagicState2024,
  title = {Magic State Cultivation: Growing {{T}} States as Cheap as {{CNOT}} Gates},
  shorttitle = {Magic State Cultivation},
  author = {Gidney, Craig and Shutty, Noah and Jones, Cody},
  date = {2024-09-26},
  eprint = {2409.17595},
  eprinttype = {arXiv},
  abstract = {We refine ideas from Knill 1996, Jones 2016, Chamberland 2020, Gidney 2023+2024, Bombin 2024, and Hirano 2024 to efficiently prepare good \$|T\textbackslash rangle\$ states. We call our construction "magic state cultivation" because it gradually grows the size and reliability of one state. Cultivation fits inside a surface code patch and uses roughly the same number of physical gates as a lattice surgery CNOT gate of equivalent reliability. We estimate the infidelity of cultivation (from injection to idling at distance 15) using a mix of state vector simulation, stabilizer simulation, error enumeration, and Monte Carlo sampling. Compared to prior work, cultivation uses an order of magnitude fewer qubit-rounds to reach logical error rates as low as \$2 \textbackslash cdot 10\textasciicircum\{-9\}\$ when subjected to \$10\textasciicircum\{-3\}\$ uniform depolarizing circuit noise. Halving the circuit noise to \$5 \textbackslash cdot 10\textasciicircum\{-4\}\$ improves the achievable logical error rate to \$4 \textbackslash cdot 10\textasciicircum\{-11\}\$. Cultivation's efficiency and strong response to improvements in physical noise suggest that further magic state distillation may never be needed in practice.},
  keywords = {Quantum Physics}
}

